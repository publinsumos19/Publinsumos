# Copia este archivo como .env.local y pega los datos de tu proyecto de Supabase
# (Supabase > Project Settings > API).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Con Railway: VITE_SUPABASE_URL es el dominio del servidor en Railway
# y VITE_SUPABASE_ANON_KEY puede ser cualquier texto, por ejemplo: publico
